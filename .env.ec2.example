# Environment configuration for AWS EC2 Deployment (t4g.small)
POSTGRES_DB=canarydb
POSTGRES_USER=canary_admin
POSTGRES_PASSWORD=generate_a_secure_db_password_here

# JWT Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET=generate_a_secure_jwt_secret_here
BOOTSTRAP_JWT_SECRET=generate_a_secure_bootstrap_secret_here

# Initial Admin Credentials
INITIAL_ADMIN_EMAIL=admin@cadoc.io
INITIAL_ADMIN_PASSWORD=Password123!

# Vault Configuration (Dev Mode)
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN=generate_a_secure_vault_token_here

# Redpanda / Kafka Telemetry Bus
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
CANARY_KAFKA_BROKERS=redpanda:9092
