[Unit]
Description=Canary Sentinel Daemon
Documentation=https://github.com/OKran0706/cadoc
After=network-online.target auditd.service
Wants=network-online.target

[Service]
ExecStartPre=/usr/bin/mkdir -p /run/canary
ExecStartPre=/usr/bin/chmod 700 /run/canary
ExecStart=/opt/canary/sentinel
Restart=always
RestartSec=10

# --- Capability Bounding ---
# Run as root but drop all capabilities except those required for
# Audit control (CAP_AUDIT_CONTROL) and
# network egress to Ingestion (CAP_NET_ADMIN).
CapabilityBoundingSet=CAP_AUDIT_CONTROL CAP_NET_ADMIN
AmbientCapabilities=CAP_AUDIT_CONTROL CAP_NET_ADMIN

# --- Filesystem Sandboxing ---
# Protect system binaries (/usr, /boot) from modification but allow
# writes to the rest of the filesystem. Sentinel needs runtime CRUD
# on canary decoy files planted at arbitrary paths (/home, /var, /etc).
ProtectSystem=full
StateDirectory=canary
PrivateTmp=true
# NOTE: ProtectHome is intentionally omitted — Sentinel plants
# canary decoy files in user home directories at runtime.

# --- Additional Hardening ---
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
